# IMPORTANT:
#   **One local env file:** copy this file to `/.env` at the **repository root** only. There is no `app/.env`.
#   From `app/`, scripts use `bun --env-file=../.env` (and usually `../.env.local`) so dev, Prisma, Vitest,
#   preview, db-pull, static datasets, etc. all read that same root file.
#   **Optional:** `app/.env.test` — Playwright/E2E-only values (e.g. `TEST_OSM_*`). Vitest does not use it.

# This file is only used during development.
# Staging/Production data is at https://github.com/FixMyBerlin/tilda-geo/settings/environments

ENVIRONMENT=development

# Docker (dev only): each worktree gets an isolated db+tiles stack (separate compose project + DB volume).
# `DEV_STACK_ID` lives in gitignored `.env.local` (created on first `bun run dev` in a worktree).
# Host ports are always 5432 (db) and 3000 (tiles); predev stops other stacks before starting yours.
# Optional: set `DEV_ATTACH_STACK=<stack-id>` in `.env.local` to reuse another worktree's stack.
#
# `COMPOSE_DEV_CONTAINER_PREFIX` is runtime-only; predev derives it from `DEV_STACK_ID` when starting Docker.
#
# Only one `bun run dev` app server at a time (port 5173 — required for OSM auth).

# Database secrets
# Use 'localhost' for local development (connects to Docker container's exposed port)
# Docker environments use 'db' (Docker service name) in docker-compose.override.yml
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_NAME=postgres
DATABASE_PASSWORD=mysecretpassword

# Remote db to be use with `bun run db-pull`
# Example production (tilda-production-postgres-tunnel): postgresql://<USER>:<PASSWORD>@localhost:5434/<NAME>
# Example staging (tilda-staging-postgres-tunnel): postgresql://<USER>:<PASSWORD>@localhost:5433/<NAME>
DATABASE_URL_PRODUCTION=
DATABASE_URL_STAGING=

# Application flags (processing container) — local dev only
# Server: `/srv/.env` is generated by `.github/workflows/setup-env.yml` from `.github/env/deploy.manifest.json`
# (GitHub environment vars/secrets). This file is never copied to staging/production.
# REMINDER: Run `docker compose` from the repo root so this file is used (not a stale copy under /app).
# Per-run overrides (PROCESS_ONLY_*, OSM2PGSQL_*, WAIT_FOR_FRESH_DATA, SKIP_WARM_CACHE): use
# `bun run processing` (prints a one-liner with inline env), not entries below.
# See app/scripts/processing-generate-command/README.md and .cursor/skills/test-processing-diff/SKILL.md
#
# Geofabrik (internal extract when both username and password are set)
PROCESS_GEOFABRIK_OAUTH_OSM_USERNAME=your-osm-username
PROCESS_GEOFABRIK_OAUTH_OSM_PASSWORD=your-osm-password
# [INFO] Use "-internal" extracts with OAuth, see https://osm-internal.download.geofabrik.de/
PROCESS_GEOFABRIK_DOWNLOAD_URL=https://osm-internal.download.geofabrik.de/europe/germany/brandenburg-latest-internal.osm.pbf
# PROCESS_GEOFABRIK_DOWNLOAD_URL=https://download.geofabrik.de/europe/germany/berlin-latest.osm.pbf
SKIP_DOWNLOAD=1 # skips the download if a file already exists
# SKIP_UNCHANGED=1 # skips processing of unchanged code
# SKIP_WARM_CACHE=1 # skips cache warming, DEV only
# WAIT_FOR_FRESH_DATA=0 # waits till the given file is from today (nightly on server: set inline on the `docker compose up` command)
PROCESSING_DIFFING_MODE=off # off | previous | fixed | reference — local dev default; server: vars.PROCESSING_DIFFING_MODE in deploy manifest
PROCESSING_DIFFING_BBOX=12.0380,51.6361,14.7271,53.2118 # Berlin + Brandenburg — required when diffing_mode != off
# Below: per-run dev overrides only (see `bun run processing`); not in deploy manifest:
# PROCESS_ONLY_TOPICS=parking # Only process those topics; Format: "topic,topic2,topic3"
# PROCESS_ONLY_BBOX=13.4178,52.4681,13.4550,52.4817 # Only process this bbox; Format: MINLON,MINLAT,MAXLON,MAXLAT
# OSM2PGSQL_LOG_LEVEL=info # 'debug' or empty (defaults to 'info') https://osm2pgsql.org/doc/manual-v1.html#logging
# OSM2PGSQL_NUMBER_PROCESSES=4 # per-run only; server default is 4 — see processing/docs/osm2pgsql-number-processes.md

# Red/Green staging -> primary promotion (optional)
# Runs with: `cd processing && bun run red-green`
PROCESSING_STAGING_DATABASE_URL=
PROMOTION_PRIMARY_DATABASE_URL=
# Optional comma-separated allowlist. If empty, promotion discovers public tables (excluding *_diff).
PROMOTION_TABLES_ALLOWLIST=
# Row-count tolerance vs primary before promotion (0.15 = 15%)
# PROMOTION_ROW_COUNT_TOLERANCE=0.15
# Baseline PBF for nightly Geofabrik reseed + intra-day pyosmium catch-up
# WORKING_PBF_PATH=/data/downloads/germany-latest.osm.pbf
# Recut source after replication. PRODUCTION: prefer a real polygon (germany.poly) —
# it clips border ways cleanly, unlike a bare bbox. DEV: leave RECUT_POLYGON_PATH empty
# and use RECUT_BBOX as a quick fallback.
RECUT_POLYGON_PATH=
# RECUT_POLYGON_PATH=/data/boundaries/germany.poly
# Where to bootstrap RECUT_POLYGON_PATH from if missing (public, no OAuth needed).
# Pair it with the Geofabrik baseline region used in PROCESS_GEOFABRIK_DOWNLOAD_URL.
# RECUT_POLYGON_DOWNLOAD_URL=https://download.geofabrik.de/europe/germany.poly
RECUT_BBOX=5.8663153,47.2701114,15.0419309,55.099161
# RECUT_PBF_PATH=/data/filtered/germany-recut.osm.pbf
# Intra-day catch-up feed (after the nightly Geofabrik reseed). When set, pyosmium runs
# with --ignore-osmosis-headers so it can follow a feed other than the baked-in one.
# Planet hourly carries full metadata; the OSM-fr Germany feed is pre-clipped (less bloat).
# REPLICATION_SERVER_URL=https://planet.osm.org/replication/hour/
# REPLICATION_SERVER_URL=https://download.openstreetmap.fr/replication/europe/germany/hour/
# REPLICATION_LOOP_SLEEP_SECONDS=60
# Nightly Geofabrik reseed at this UTC hour (default 0). Force with RED_GREEN_FORCE_RESEED=1
# RED_GREEN_RESEED_UTC_HOUR=0
# Pipeline checks before/after promotion (comma separated URLs)
RED_GREEN_VERIFY_ENDPOINTS=http://127.0.0.1:4000/,http://127.0.0.1:3000/catalog
# Optional:
# WARM_CACHE_MODE=full # full | delta (delta currently feature-flagged fallback behavior)
# DELTA_WARM_CACHE_BBOX=13.0883,52.3382,13.7611,52.6755
# DELTA_WARM_CACHE_MIN_ZOOM=9
# DELTA_WARM_CACHE_MAX_ZOOM=13
# DELTA_WARM_CACHE_TABLES=bikelanes,roads,roadsPathClasses

# In staging/production, these come from GitHub environment variables (vars.VITE_APP_ORIGIN, vars.VITE_APP_ENV)
# Local dev: use http://127.0.0.1:5173 (OSM allows HTTP for 127.0.0.1 only). See docs/Local-Development-Domain-Setup.md
VITE_APP_ORIGIN=http://127.0.0.1:5173
VITE_APP_ENV=development # development | staging | production
# Generate with `openssl rand -base64 32`
SESSION_SECRET_KEY=

# E-Mail – Only on the server – https://app.brevo.com/settings/keys/api
BREVO_API_KEY=''

# MAP API KEYS (See Bitwarden "TILDA Secrets")
# Source: https://account.mapbox.com/access-tokens/cl7079ubp09vs3osbzaovy3ge
MAPBOX_STYLE_ACCESS_TOKEN='' # pk.foo…
# Source: https://account.mapbox.com/access-tokens/clewefi6l20053yp1x8xpvopi
MAPBOX_PARKING_STYLE_ACCESS_TOKEN='' # pk.bar…

# LOGIN (See Bitwarden "TILDA Secrets")
# LOGIN auf master.apis.dev.openstreetmap.org
#   Docs https://wiki.openstreetmap.org/wiki/Sandbox_for_editing
# OSM_CLIENT_ID=your-staging-osm-client-id
# OSM_CLIENT_SECRET=your-staging-osm-client-secret
# LOGIN auf www.openstreetmap.org
OSM_CLIENT_ID=your-osm-client-id
OSM_CLIENT_SECRET=your-osm-client-secret

# S3 object storage (See Bitwarden "TILDA Secrets")
S3_KEY=your-s3-key
S3_SECRET=your-s3-secret
S3_REGION=eu-central-1
# See https://s3.console.aws.amazon.com/s3/buckets/atlas-private?region=eu-central-1&bucketType=general&tab=objects
S3_BUCKET=atlas-private

# Atlas API (See Bitwarden "TILDA Secrets")
# App server: one key per deployment (required).
ATLAS_API_KEY=your-atlas-api-key
# StaticDatasets script only — required when running `bun run static-datasets-update -- --env=staging` from your machine (staging API expects this key; do not use ATLAS_API_KEY for that).
ATLAS_API_KEY_STAGING=
# StaticDatasets script only — required when running with `--env=production`.
ATLAS_API_KEY_PRODUCTION=

# MAPROULETTE: https://maproulette.org/user/profile for user `osm-verkehrswende-org`
MAPROULETTE_API_KEY=your-maproulette-api-key

# TESTING: Enable Playwright E2E testing mode
VITE_PLAYWRIGHT_ENABLED=true

# Deployment hostnames (infra only)
# In staging/production, these values come from GitHub environment variables (vars.APP_URL, vars.CACHELESS_URL, vars.TILES_URL)
# These can stay empty for development. They are only used by manifest/deploy and Traefik (not app startup validation).
APP_URL='app.invalid'
CACHELESS_URL='cacheless.invalid'
TILES_URL='tiles.invalid'

# Private ECR registry URL (e.g. 123456789.dkr.ecr.eu-central-1.amazonaws.com)
# In staging/production, this comes from the GitHub environment variable vars.ECR_REGISTRY
ECR_REGISTRY=''

# Cursor MCP (STG/PRD) — create a token and paste it here
#   STG: https://staging.tilda-geo.de/admin/api-tokens
#   PRD: https://tilda-geo.de/admin/api-tokens
TILDA_GEO_ADMIN_API_TOKEN_STG=
TILDA_GEO_ADMIN_API_TOKEN_PRD=
