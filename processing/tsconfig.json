{
  // Soft-aligned to @total-typescript/tsconfig bundler/no-dom (no extends): https://github.com/total-typescript/tsconfig
  "include": ["**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "ES2022",
    // ES2025 so native Set methods (Set.intersection/difference in steps/processTopics.ts)
    // are typed. Requires workspace TS 7+ (.vscode/settings.json → js/ts.tsdk.path).
    "lib": ["ES2025"],
    "types": ["bun-types"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
