{
  // Soft-aligned to @total-typescript/tsconfig bundler/no-dom (no extends): https://github.com/total-typescript/tsconfig
  "include": ["**/*.ts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "ES2022",
    // ES2025 (not ES2022) so the native Set methods we use (Set.intersection/difference,
    // see steps/processTopics.ts) are typed. Bun supports them at runtime.
    "lib": ["ES2025"],
    "types": ["node"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
