{
  "name": "processing",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "nub ./scripts/run-tests.ts",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings .",
    "format": "oxfmt --write -c ../app/oxfmt.config.mjs .",
    "check": "run-p type-check type-check-lua check-lint check-format test",
    "check-lint": "oxlint .",
    "check-format": "oxfmt --check -c ../app/oxfmt.config.mjs .",
    "type-check": "nubx tsc --noEmit -p tsconfig.json",
    "type-check-lua": "nub ./scripts/run-typecheck-lua.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@turf/turf": "^7.3.5",
    "date-fns": "^4.4.0",
    "geojson": "^0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.54.0",
    "oxlint": "1.69.0",
    "postgres": "^3.4.9",
    "tinyexec": "^1.2.4",
    "typescript": "7.0.1-rc"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.1-rc",
    "@typescript/typescript-linux-x64": "7.0.1-rc"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.1.9",
      "onFail": "warn"
    }
  },
  "packageManager": "nub@0.1.9"
}
