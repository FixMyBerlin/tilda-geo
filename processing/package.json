{
  "name": "processing",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "bun ./scripts/run-tests.ts",
    "lint": "biome lint --write .",
    "format": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' oxfmt --write -c ../app/oxfmt.config.ts .",
    "check": "bun --parallel check:type check:format check:lint",
    "check:type": "bun run typecheck",
    "check:format": "bun run format",
    "check:lint": "biome check --write .",
    "typecheck": "bun ./scripts/run-typecheck-lua.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@turf/turf": "^7.3.2",
    "date-fns": "^4.1.0",
    "geojson": "^0.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "^1.3.6",
    "oxfmt": "^0.52.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  }
}
