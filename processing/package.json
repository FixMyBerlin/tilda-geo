{
  "name": "processing",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "test": "bun ./scripts/run-tests.ts",
    "lint": "oxlint --fix --fix-dangerously --deny-warnings .",
    "format": "oxfmt --write -c ../app/oxfmt.config.mjs .",
    "check": "bun run --parallel type-check type-check-lua check-lint check-format test",
    "check-pre-push": "bun run --parallel type-check type-check-lua check-lint check-format test",
    "check-lint": "oxlint .",
    "check-format": "oxfmt --check -c ../app/oxfmt.config.mjs .",
    "type-check": "bunx tsc --noEmit -p tsconfig.json",
    "type-check-lua": "bun ./scripts/run-typecheck-lua.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@turf/turf": "^7.3.5",
    "date-fns": "^4.4.0",
    "geojson": "^0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bun-types": "1.3.14",
    "oxfmt": "0.65.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "trustedDependencies": [
    "bun-types"
  ]
}
