{
  "variables": [
    {
      "name": "ENVIRONMENT",
      "sourceEnv": "INPUT_ENVIRONMENT",
      "required": true,
      "githubSource": "inputs.ENVIRONMENT",
      "description": "Deployment target environment (staging|production)."
    },
    {
      "name": "DATABASE_HOST",
      "sourceEnv": "VAR_DATABASE_HOST",
      "required": true,
      "githubSource": "vars.DATABASE_HOST",
      "description": "Database host used by app/processing and PG client variables."
    },
    {
      "name": "DATABASE_USER",
      "sourceEnv": "SECRET_DATABASE_USER",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.DATABASE_USER",
      "description": "Database username."
    },
    {
      "name": "DATABASE_PASSWORD",
      "sourceEnv": "SECRET_DATABASE_PASSWORD",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.DATABASE_PASSWORD",
      "description": "Database password."
    },
    {
      "name": "DATABASE_NAME",
      "sourceEnv": "SECRET_DATABASE_NAME",
      "required": true,
      "githubSource": "secrets.DATABASE_NAME",
      "description": "Database name."
    },
    {
      "name": "PROCESS_GEOFABRIK_DOWNLOAD_URL",
      "sourceEnv": "VAR_PROCESS_GEOFABRIK_DOWNLOAD_URL",
      "required": true,
      "githubSource": "vars.PROCESS_GEOFABRIK_DOWNLOAD_URL",
      "description": "PBF download URL (internal/public Geofabrik extract)."
    },
    {
      "name": "PROCESS_GEOFABRIK_OAUTH_OSM_USERNAME",
      "sourceEnv": "SECRET_PROCESS_GEOFABRIK_OAUTH_OSM_USERNAME",
      "required": false,
      "sensitive": true,
      "githubSource": "secrets.PROCESS_GEOFABRIK_OAUTH_OSM_USERNAME",
      "description": "Optional Geofabrik OAuth username."
    },
    {
      "name": "PROCESS_GEOFABRIK_OAUTH_OSM_PASSWORD",
      "sourceEnv": "SECRET_PROCESS_GEOFABRIK_OAUTH_OSM_PASSWORD",
      "required": false,
      "sensitive": true,
      "githubSource": "secrets.PROCESS_GEOFABRIK_OAUTH_OSM_PASSWORD",
      "description": "Optional Geofabrik OAuth password."
    },
    {
      "name": "TILES_URL",
      "sourceEnv": "VAR_TILES_URL",
      "required": true,
      "githubSource": "vars.TILES_URL",
      "description": "Public tile endpoint hostname."
    },
    {
      "name": "CACHELESS_URL",
      "sourceEnv": "VAR_CACHELESS_URL",
      "required": true,
      "githubSource": "vars.CACHELESS_URL",
      "description": "Cacheless tile endpoint hostname."
    },
    {
      "name": "VITE_APP_ORIGIN",
      "sourceEnv": "VAR_VITE_APP_ORIGIN",
      "required": true,
      "githubSource": "vars.VITE_APP_ORIGIN",
      "description": "Public app origin."
    },
    {
      "name": "VITE_APP_ENV",
      "sourceEnv": "VAR_VITE_APP_ENV",
      "required": true,
      "githubSource": "vars.VITE_APP_ENV",
      "description": "App environment for client/server behavior."
    },
    {
      "name": "APP_URL",
      "sourceEnv": "VAR_APP_URL",
      "required": true,
      "githubSource": "vars.APP_URL",
      "description": "Main app hostname used by Traefik labels."
    },
    {
      "name": "SESSION_SECRET_KEY",
      "sourceEnv": "SECRET_SESSION_SECRET_KEY",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.SESSION_SECRET_KEY",
      "description": "Session signing secret."
    },
    {
      "name": "OSM_CLIENT_ID",
      "sourceEnv": "SECRET_OSM_CLIENT_ID",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.OSM_CLIENT_ID",
      "description": "OSM OAuth client ID."
    },
    {
      "name": "OSM_CLIENT_SECRET",
      "sourceEnv": "SECRET_OSM_CLIENT_SECRET",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.OSM_CLIENT_SECRET",
      "description": "OSM OAuth client secret."
    },
    {
      "name": "S3_KEY",
      "sourceEnv": "SECRET_S3_KEY",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.S3_KEY",
      "description": "S3 access key."
    },
    {
      "name": "S3_SECRET",
      "sourceEnv": "SECRET_S3_SECRET",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.S3_SECRET",
      "description": "S3 secret key."
    },
    {
      "name": "S3_REGION",
      "sourceEnv": "SECRET_S3_REGION",
      "required": true,
      "githubSource": "secrets.S3_REGION",
      "description": "S3 region."
    },
    {
      "name": "S3_BUCKET",
      "sourceEnv": "SECRET_S3_BUCKET",
      "required": true,
      "githubSource": "secrets.S3_BUCKET",
      "description": "S3 bucket used by app/scripts."
    },
    {
      "name": "ATLAS_API_KEY",
      "sourceEnv": "SECRET_ATLAS_API_KEY",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.ATLAS_API_KEY",
      "description": "Internal atlas API key."
    },
    {
      "name": "MAPROULETTE_API_KEY",
      "sourceEnv": "SECRET_MAPROULETTE_API_KEY",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.MAPROULETTE_API_KEY",
      "description": "MapRoulette API key."
    },
    {
      "name": "BREVO_API_KEY",
      "sourceEnv": "SECRET_BREVO_API_KEY",
      "required": true,
      "sensitive": true,
      "githubSource": "secrets.BREVO_API_KEY",
      "description": "Brevo API key for transactional email delivery."
    },
    {
      "name": "SKIP_DOWNLOAD",
      "sourceEnv": "VAR_SKIP_DOWNLOAD",
      "required": false,
      "defaultValue": "1",
      "githubSource": "vars.SKIP_DOWNLOAD",
      "description": "Processing flag (default 1)."
    },
    {
      "name": "SKIP_UNCHANGED",
      "sourceEnv": "VAR_SKIP_UNCHANGED",
      "required": false,
      "defaultValue": "0",
      "githubSource": "vars.SKIP_UNCHANGED",
      "description": "Processing flag (default 0)."
    },
    {
      "name": "PROCESSING_DIFFING_MODE",
      "sourceEnv": "VAR_PROCESSING_DIFFING_MODE",
      "required": true,
      "githubSource": "vars.PROCESSING_DIFFING_MODE",
      "description": "Diffing mode for processing."
    },
    {
      "name": "PROCESSING_DIFFING_BBOX",
      "sourceEnv": "VAR_PROCESSING_DIFFING_BBOX",
      "required": true,
      "githubSource": "vars.PROCESSING_DIFFING_BBOX",
      "description": "Diffing bbox for processing."
    },
    {
      "name": "ECR_REGISTRY",
      "sourceEnv": "VAR_ECR_REGISTRY",
      "required": true,
      "githubSource": "vars.ECR_REGISTRY",
      "description": "Private ECR registry URL used by docker-compose to pull images."
    },
    {
      "name": "PROCESSING_STAGING_DATABASE_URL",
      "sourceEnv": "SECRET_PROCESSING_STAGING_DATABASE_URL",
      "required": false,
      "sensitive": true,
      "githubSource": "secrets.PROCESSING_STAGING_DATABASE_URL",
      "description": "Red/green: writable secondary DB the staging build targets."
    },
    {
      "name": "PROMOTION_PRIMARY_DATABASE_URL",
      "sourceEnv": "SECRET_PROMOTION_PRIMARY_DATABASE_URL",
      "required": false,
      "sensitive": true,
      "githubSource": "secrets.PROMOTION_PRIMARY_DATABASE_URL",
      "description": "Red/green: fixed primary DB that receives promoted geo tables via FDW."
    },
    {
      "name": "PROMOTION_TABLES_ALLOWLIST",
      "sourceEnv": "VAR_PROMOTION_TABLES_ALLOWLIST",
      "required": false,
      "githubSource": "vars.PROMOTION_TABLES_ALLOWLIST",
      "description": "Red/green: optional comma-separated promote allowlist (empty = auto-discover public tables)."
    },
    {
      "name": "PROMOTION_ROW_COUNT_TOLERANCE",
      "sourceEnv": "VAR_PROMOTION_ROW_COUNT_TOLERANCE",
      "required": false,
      "defaultValue": "0.15",
      "githubSource": "vars.PROMOTION_ROW_COUNT_TOLERANCE",
      "description": "Red/green: max relative row-count delta vs primary before promotion (0.15 = 15%)."
    },
    {
      "name": "WORKING_PBF_PATH",
      "sourceEnv": "VAR_WORKING_PBF_PATH",
      "required": false,
      "githubSource": "vars.WORKING_PBF_PATH",
      "description": "Red/green: Geofabrik baseline PBF reseeded nightly and caught up intra-day."
    },
    {
      "name": "RECUT_PBF_PATH",
      "sourceEnv": "VAR_RECUT_PBF_PATH",
      "required": false,
      "githubSource": "vars.RECUT_PBF_PATH",
      "description": "Red/green: output path for the Germany recut extract."
    },
    {
      "name": "RECUT_POLYGON_PATH",
      "sourceEnv": "VAR_RECUT_POLYGON_PATH",
      "required": false,
      "githubSource": "vars.RECUT_POLYGON_PATH",
      "description": "Red/green: clip polygon for osmium extract (preferred over RECUT_BBOX in production)."
    },
    {
      "name": "RECUT_POLYGON_DOWNLOAD_URL",
      "sourceEnv": "VAR_RECUT_POLYGON_DOWNLOAD_URL",
      "required": false,
      "githubSource": "vars.RECUT_POLYGON_DOWNLOAD_URL",
      "description": "Red/green: URL to bootstrap RECUT_POLYGON_PATH from when missing (e.g. germany.poly)."
    },
    {
      "name": "RECUT_BBOX",
      "sourceEnv": "VAR_RECUT_BBOX",
      "required": false,
      "githubSource": "vars.RECUT_BBOX",
      "description": "Red/green: bbox recut fallback when RECUT_POLYGON_PATH is unset (dev/smoke)."
    },
    {
      "name": "REPLICATION_SERVER_URL",
      "sourceEnv": "VAR_REPLICATION_SERVER_URL",
      "required": false,
      "githubSource": "vars.REPLICATION_SERVER_URL",
      "description": "Red/green: intra-day replication feed (planet hourly or OSM-fr Germany)."
    },
    {
      "name": "REPLICATION_LOOP_SLEEP_SECONDS",
      "sourceEnv": "VAR_REPLICATION_LOOP_SLEEP_SECONDS",
      "required": false,
      "defaultValue": "60",
      "githubSource": "vars.REPLICATION_LOOP_SLEEP_SECONDS",
      "description": "Red/green: sleep between pyosmium catch-up retries."
    },
    {
      "name": "RED_GREEN_VERIFY_ENDPOINTS",
      "sourceEnv": "VAR_RED_GREEN_VERIFY_ENDPOINTS",
      "required": false,
      "githubSource": "vars.RED_GREEN_VERIFY_ENDPOINTS",
      "description": "Red/green: comma-separated health URLs probed before/after promotion (mandatory at runtime)."
    },
    {
      "name": "RED_GREEN_VERIFY_INTERVAL_MS",
      "sourceEnv": "VAR_RED_GREEN_VERIFY_INTERVAL_MS",
      "required": false,
      "defaultValue": "5000",
      "githubSource": "vars.RED_GREEN_VERIFY_INTERVAL_MS",
      "description": "Red/green: verifier polling interval."
    },
    {
      "name": "RED_GREEN_MAX_FAILURE_STREAK",
      "sourceEnv": "VAR_RED_GREEN_MAX_FAILURE_STREAK",
      "required": false,
      "defaultValue": "3",
      "githubSource": "vars.RED_GREEN_MAX_FAILURE_STREAK",
      "description": "Red/green: max tolerated consecutive failed probes before the run fails."
    },
    {
      "name": "RED_GREEN_RESEED_UTC_HOUR",
      "sourceEnv": "VAR_RED_GREEN_RESEED_UTC_HOUR",
      "required": false,
      "defaultValue": "0",
      "githubSource": "vars.RED_GREEN_RESEED_UTC_HOUR",
      "description": "Red/green: UTC hour for the nightly Geofabrik reseed."
    },
    {
      "name": "RED_GREEN_FORCE_RESEED",
      "sourceEnv": "VAR_RED_GREEN_FORCE_RESEED",
      "required": false,
      "githubSource": "vars.RED_GREEN_FORCE_RESEED",
      "description": "Red/green: set to 1 to force a Geofabrik reseed on the next run."
    },
    {
      "name": "RED_GREEN_LOCK_TTL_SECONDS",
      "sourceEnv": "VAR_RED_GREEN_LOCK_TTL_SECONDS",
      "required": false,
      "defaultValue": "14400",
      "githubSource": "vars.RED_GREEN_LOCK_TTL_SECONDS",
      "description": "Red/green: a lock older than this is treated as stale and broken (crash recovery)."
    },
    {
      "name": "RED_GREEN_DELTA_WARM_ENDPOINT",
      "sourceEnv": "VAR_RED_GREEN_DELTA_WARM_ENDPOINT",
      "required": false,
      "githubSource": "vars.RED_GREEN_DELTA_WARM_ENDPOINT",
      "description": "Red/green: private endpoint for delta warm-cache when WARM_CACHE_MODE=delta."
    },
    {
      "name": "WARM_CACHE_MODE",
      "sourceEnv": "VAR_WARM_CACHE_MODE",
      "required": false,
      "defaultValue": "full",
      "githubSource": "vars.WARM_CACHE_MODE",
      "description": "Red/green: 'full' (default) or 'delta' warm-cache after promotion."
    }
  ]
}
