{
  // Soft-aligned to @total-typescript/tsconfig bundler/dom (no extends): https://github.com/total-typescript/tsconfig
  // Intentionally NOT adopted
  //   verbatimModuleSyntax: true  — TanStack Start client/server split: type-only imports can become empty runtime imports and leak server code into client bundles
  //   module: "preserve"          — total-typescript bundler default; TanStack Start recommends ESNext for this stack
  //   noUnusedLocals / noUnusedParameters — unused-code checks delegated to oxlint (oxlint.config.mjs); avoid duplicate signal with tsc
  "include": ["**/*.ts", "**/*.tsx", "vite.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun-types", "web"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noErrorTruncation": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/scripts/*": ["./scripts/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/*.e2e.ts",
    "cypress",
    ".next",
    ".output",
    "dist",
    "processing",
    "warm-cache",
    "cache",
    "configs"
  ]
}
