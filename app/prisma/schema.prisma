// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgres"
  schemas  = ["prisma"]
}

generator client {
  provider            = "prisma-client"
  output              = "../src/prisma/generated"
  runtime             = "bun"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

model User {
  // Better Auth core fields
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  email         String   @unique // Placeholder-E-Mail from better auth. Used as Contact email when provided by user, editable via settings.
  emailVerified Boolean  @default(false)

  // OSM-sourced fields (synced from OSM API on each login via mapProfileToUser)
  osmId          Int     @unique // OSM user ID (from OSM API user.id)
  osmName        String? // OSM display name (from OSM API user.display_name) - mapped to Better Auth 'name'
  osmDescription String? // OSM profile description (from OSM API user.description) - synced on login, can be cleared by admin
  osmAvatar      String? // OSM avatar URL (from OSM API user.img.href) - mapped to Better Auth 'image'

  // User-managed fields (editable by user via settings)
  firstName String? // User's first name (editable via UserForm)
  lastName  String? // User's last name (editable via UserForm)

  // App-managed fields
  role              UserRoleEnum       @default(USER) // User role (USER/ADMIN) - set on user creation, managed by admins
  accessedRegions   Json?              @default("[]") // Region access tracking (JSON array) - managed by app logic
  //
  sessions       Session[]
  accounts       Account[]
  verifications  Verification[]
  memberships    Membership[]
  notes          Note[]
  noteComments   NoteComment[]
  qaEvaluations  QaEvaluation[]
  adminApiTokens AdminApiToken[]
  //
  // Planning module: scenarios this user created (any region member may still edit them).
  planningScenarios PlanningScenario[]

  @@map("User")
  @@schema("prisma")
}

enum UserRoleEnum {
  USER
  ADMIN

  @@schema("prisma")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Session")
  @@schema("prisma")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  //
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  //
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("Account")
  @@schema("prisma")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?

  //
  @@unique([identifier, value])
  @@map("Verification")
  @@schema("prisma")
}

enum RegionStatus {
  PUBLIC
  PRIVATE
  DEACTIVATED

  @@schema("prisma")
}

enum RegionProduct {
  radverkehr
  parkraum
  fussverkehr
  analysis

  @@schema("prisma")
}

enum RegionNotesMode {
  osmNotes
  internalNotes
  disabled

  @@schema("prisma")
}

enum RegionContractStatus {
  ACTIVE
  INACTIVE

  @@schema("prisma")
}

model RegionContract {
  id        Int                  @id @default(autoincrement())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  slug      String               @unique
  name      String
  status    RegionContractStatus @default(ACTIVE)
  regions   Region[]

  @@map("RegionContract")
  @@schema("prisma")
}

model Region {
  id        Int          @id @default(autoincrement())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  //
  slug      String       @unique
  promoted  Boolean      @default(false)
  status    RegionStatus @default(PUBLIC)

  name       String          @default("")
  fullName   String          @default("")
  product    RegionProduct   @default(radverkehr)
  notes      RegionNotesMode @default(osmNotes)
  showSearch Boolean         @default(false)

  mapLat  Float @default(0)
  mapLng  Float @default(0)
  mapZoom Float @default(10)

  logoWhiteBackgroundRequired Boolean @default(false)

  // Active header logo via RegionUpload FK.
  headerLogoId Int?
  headerLogo   RegionUpload? @relation("RegionHeaderLogo", fields: [headerLogoId], references: [id], onDelete: SetNull)

  maskOsmRelationIds Int[]  @default([])
  maskBufferKm       Float  @default(10)

  /// GeoJSON 2D bbox: [minLng, minLat, maxLng, maxLat]
  bbox Json?

  /// { minZoom, maxZoom, tables: string[] }
  cacheWarming Json?

  contractId Int?
  contract   RegionContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  categoryAssignments   RegionCategoryAssignment[]
  backgroundAssignments RegionBackgroundAssignment[]
  exportAssignments     RegionExportAssignment[]
  navigationLinks       RegionNavigationLink[]

  memberships       Membership[]
  mapDatasetUploads MapDatasetUpload[] @relation("RegionToMapDatasetUpload")
  regionUploads     RegionUpload[]     @relation("RegionUploadLibrary")
  noteRecords       Note[]
  qaConfigs         QaConfig[]
  planningScenarios PlanningScenario[]

  @@index([contractId])
  @@index([headerLogoId])
  @@map("Region")
  @@schema("prisma")
}

/// Per-region file library (logos, …). Stored in S3 under the code-defined `region-uploads/` prefix
/// (see regionUploadsS3.server.ts). A row's role is defined by which Region FK points at it
/// (e.g. headerLogoId) — there is no `purpose` column.
model RegionUpload {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title    String
  s3Key    String @unique
  mimeType String
  fileSize Int

  regionId Int
  region   Region @relation("RegionUploadLibrary", fields: [regionId], references: [id], onDelete: Cascade)

  /// Better Auth user id of the admin who uploaded it (audit; not an FK to keep User untouched).
  createdById String?

  headerLogoForRegions Region[] @relation("RegionHeaderLogo")

  @@index([regionId])
  @@map("RegionUpload")
  @@schema("prisma")
}

model RegionCategoryAssignment {
  id         Int    @id @default(autoincrement())
  regionId   Int
  categoryId String
  sortOrder  Int
  region     Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, categoryId])
  @@map("RegionCategoryAssignment")
  @@schema("prisma")
}

model RegionBackgroundAssignment {
  id         Int    @id @default(autoincrement())
  regionId   Int
  sourceId   String
  region     Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, sourceId])
  @@map("RegionBackgroundAssignment")
  @@schema("prisma")
}

model RegionExportAssignment {
  id        Int    @id @default(autoincrement())
  regionId  Int
  exportId  String
  region    Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, exportId])
  @@map("RegionExportAssignment")
  @@schema("prisma")
}

model RegionNavigationLink {
  id           Int     @id @default(autoincrement())
  regionId     Int
  name         String
  internalPath String?
  externalUrl  String?
  sortOrder    Int
  region       Region  @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@map("RegionNavigationLink")
  @@schema("prisma")
}

// Decode templates for the `?config=checksum.bits` URL param. Keyed by checksum (region-agnostic,
// immutable per checksum), upserted whenever a region's categories are saved. Not audited
// (derived data). See regionConfigTemplates.server.ts.
model RegionConfigTemplate {
  checksum  String   @id
  template  Json
  createdAt DateTime @default(now())

  @@map("RegionConfigTemplate")
  @@schema("prisma")
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  recordId      String
  action        String
  model         String
  oldData       Json?
  newData       Json?
  changedFields String[]
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([model, recordId])
  @@index([createdAt])
  @@map("AuditLog")
  @@schema("prisma")
}

model AdminApiToken {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String
  hashedToken String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("AdminApiToken")
  @@schema("prisma")
}

model Membership {
  id Int @id @default(autoincrement())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  region   Region @relation(fields: [regionId], references: [id])
  regionId Int

  @@unique([regionId, userId])
  @@map("Membership")
  @@schema("prisma")
}

/// Map-dataset file artifact (PMTiles/GeoJSON shown on the map), one row per static-dataset folder.
/// Distinct from RegionUpload (region logos).
model MapDatasetUpload {
  id                Int                       @id @default(autoincrement())
  createdAt         DateTime                  @default(now())
  createdBy         MapDatasetUploadCreatedBy @default(SCRIPT)
  updatedAt         DateTime                  @updatedAt
  //
  slug              String                    @unique
  configs           Json
  public            Boolean                   @default(false)
  hideDownloadLink  Boolean                   @default(false)
  mapRenderFormat   MapRenderFormatEnum
  mapRenderUrl      String
  githubUrl         String
  // One of them is missing when `dataSourceType: 'external'` (because external sources are "either or")
  pmtilesUrl        String?
  geojsonUrl        String?
  //
  externalSourceUrl String?
  cacheTtlSeconds   Int?                      @default(86400)
  //
  systemLayer       Boolean                   @default(false)
  //
  // File-level metadata (one value per dataset file, not per layer-config "Ansicht").
  // Admin/CSV read these columns (and `layerConfigs` rows); map region datasets still expand `configs` JSON.
  attributionHtml      String?
  dataSourceMarkdown   String?
  dataUpdatedNote      String? // free-text e.g. "2024-11-13" — kept separate from the row's updatedAt
  licence              String? // licence enum values as in StaticDatasets/types.ts
  licenceOsmCompatible String? // 'licence' | 'waiver' | 'no'
  //
  regions           Region[]                  @relation("RegionToMapDatasetUpload")
  layerConfigs      MapDatasetLayerConfig[]

  @@map("MapDatasetUpload")
  @@schema("prisma")
}

/// One layer-config "Ansicht" of a MapDatasetUpload. Synced from `configs[]` on upload create;
/// admin UI reads these rows while `configs` JSON remains the wire format from static-dataset scripts.
model MapDatasetLayerConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mapDatasetUploadId Int
  mapDatasetUpload   MapDatasetUpload @relation(fields: [mapDatasetUploadId], references: [id], onDelete: Cascade)

  /// null = the dataset's primary view. Unique per upload (Postgres treats NULLs as distinct).
  subId       String?
  name        String
  /// Same string as MapDatasetUpload.configs[].categoryKey → MapDatasetCategory.key.
  categoryKey String?

  layers      Json
  inspector   Json
  legends     Json?
  osmIdConfig Json?
  description String?

  @@unique([mapDatasetUploadId, subId])
  @@index([categoryKey])
  @@map("MapDatasetLayerConfig")
  @@schema("prisma")
}

model MapDatasetCategory {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Same string as MapDatasetUpload.configs[].categoryKey (e.g. bb/Netzkonzeption). Globally unique.
  key         String @unique @db.VarChar(191)

  /// First path segment (before first `/`), e.g. bb from bb/Netzkonzeption.
  groupKey String @db.VarChar(191)

  /// Rest after first `/`, e.g. Netzkonzeption.
  categoryKey String @db.VarChar(191)

  /// Display order in the region sidebar; supports fractional values (e.g. 1.5).
  sortOrder Float

  /// Max lengths: `mapDatasetCategoryDisplayLimits.ts`.
  title    String  @db.VarChar(40)
  subtitle String? @db.VarChar(100)

  @@unique([groupKey, categoryKey])
  @@index([groupKey, sortOrder, categoryKey])
  @@map("MapDatasetCategory")
  @@schema("prisma")
}

enum MapDatasetUploadCreatedBy {
  USER
  SCRIPT

  @@schema("prisma")
}

enum MapRenderFormatEnum {
  pmtiles
  geojson

  @@schema("prisma")
}

model Note {
  id           Int           @id @default(autoincrement())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  //
  author       User          @relation(fields: [userId], references: [id])
  userId       String
  //
  region       Region        @relation(fields: [regionId], references: [id])
  regionId     Int
  //
  subject      String
  body         String?
  resolvedAt   DateTime?
  latitude     Float
  longitude    Float
  // osm_type    String?       @db.VarChar
  // osm_id      String?
  //
  noteComments NoteComment[]

  @@map("Note")
  @@schema("prisma")
}

model NoteComment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  //
  author    User     @relation(fields: [userId], references: [id])
  userId    String
  //
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  noteId    Int
  //
  body      String

  @@map("NoteComment")
  @@schema("prisma")
}

// QA System Models
model QaConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug     String // e.g., "euvm_parking_capacity"
  label    String // e.g., "eUVM Parkplätze Kapazität"
  isActive Boolean @default(true)

  // Reference to existing data table (with schema prefix)
  mapTable String // e.g., "public.qa_parkings_euvm"

  // Map attribution for the source
  mapAttribution String? // e.g., "QA Data: tilda-geo.de"

  // Thresholds for automatic system evaluation
  goodThreshold               Float @default(0.1) // relative <= 0.1 difference = GOOD
  needsReviewThreshold        Float @default(0.2) // relative <= 0.2 difference = NEEDS_REVIEW
  absoluteDifferenceThreshold Int   @default(4) // absolute difference <= this value is not considered a change

  region   Region @relation(fields: [regionId], references: [id])
  regionId Int

  qaEvaluations QaEvaluation[]

  @@unique([regionId, slug])
  @@map("QaConfig")
  @@schema("prisma")
}

model QaEvaluation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reference to row in existing data table (could be voronoi, h3, etc.)
  areaId String // Links to public.qa_parkings_euvm.id

  // System automatic evaluation (based on thresholds)
  systemStatus QaSystemStatus @default(NEEDS_REVIEW)

  // Manual user evaluation status
  userStatus QaEvaluationStatus? // NULL means no user decision yet

  // Optional evaluation text/reasoning (only for user evaluations)
  body String?

  // Snapshot of data used for this evaluation
  decisionData Json?

  config   QaConfig @relation(fields: [configId], references: [id])
  configId Int

  // Evaluator tracking - either system or user
  evaluatorType QaEvaluatorType @default(SYSTEM)
  author        User?           @relation(fields: [userId], references: [id])
  userId        String?

  // Remove unique constraint to allow evaluation history
  // @@unique([configId, areaId])  // REMOVED

  @@map("QaEvaluation")
  @@schema("prisma")
}

enum QaSystemStatus {
  GOOD // Green - no review needed
  NEEDS_REVIEW // Yellow - medium difference
  PROBLEMATIC // Red - large difference

  @@schema("prisma")
}

enum QaEvaluationStatus {
  OK_STRUCTURAL_CHANGE // "Diff OK, caused by structural change in the area like construction"
  OK_REFERENCE_ERROR // "Diff OK, caused by wrong past/reference data"
  NOT_OK_DATA_ERROR // "Diff not OK, current data needs to be fixed"
  NOT_OK_PROCESSING_ERROR // "Diff not OK, processing needs to be fixed"
  OK_QA_TOOLING_ERROR // "Diff OK, caused by methodical error in QA tooling (geometries/definitions)"

  @@schema("prisma")
}

enum QaEvaluatorType {
  SYSTEM
  USER

  @@schema("prisma")
}

// ── Planning module (Flächenfinder) ──────────────────────────────────────────
// New, additive product module. A scenario ("Datenstand") holds an editable
// factorConfig; running it enqueues a PlanningJob that the Python worker consumes
// and turns into an immutable PlanningRun whose geometries live in the `planning`
// PostGIS schema (keyed by run id = PlanningRun.id), served via Martin functions.
//
// Permissions: any region member may edit/run any scenario of that region; the
// creator is tracked for attribution only. Scenarios can build upon each other
// via `parentId` (lineage).

model PlanningScenario {
  id           Int                @id @default(autoincrement())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  //
  title        String
  description  String?
  //
  region       Region             @relation(fields: [regionId], references: [id])
  regionId     Int
  //
  // Attribution only — editing is open to all region members.
  creator      User               @relation(fields: [creatorId], references: [id])
  creatorId    String
  //
  // Lineage: "build upon" creates a child scenario seeded from the parent's config.
  parent       PlanningScenario?  @relation("Lineage", fields: [parentId], references: [id])
  parentId     Int?
  children     PlanningScenario[] @relation("Lineage")
  //
  // Editable UseCaseConfig: weights, hard thresholds, targets, h3_resolution,
  // dem_source, and the study-area geometry (GeoJSON).
  factorConfig Json
  //
  // Pointer to the latest successful run used for display. Plain Int (logical FK
  // to PlanningRun.id) to avoid a relation cycle.
  currentRunId Int?
  //
  runs         PlanningRun[]
  jobs         PlanningJob[]

  @@index([regionId])
  @@map("PlanningScenario")
  @@schema("prisma")
}

model PlanningRun {
  id                   Int               @id @default(autoincrement())
  createdAt            DateTime          @default(now())
  //
  scenario             PlanningScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId           Int
  //
  // Frozen copy of the config used for THIS run (reproducibility).
  factorConfigSnapshot Json
  //
  status               PlanningRunStatus @default(PENDING)
  hexCount             Int?
  vegCount             Int?
  cirAttribution       String?
  //
  job                  PlanningJob?

  @@index([scenarioId])
  @@map("PlanningRun")
  @@schema("prisma")
}

model PlanningJob {
  id           Int               @id @default(autoincrement())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  //
  scenario     PlanningScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scenarioId   Int
  //
  status       PlanningJobStatus @default(QUEUED)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  // Fortschritt 0–100 + Kurzlabel, vom planning-worker während der Berechnung gesetzt.
  progress      Int?
  progressLabel String?
  //
  // Set when DONE — links to the immutable run used for tile display.
  resultRun    PlanningRun?      @relation(fields: [resultRunId], references: [id])
  resultRunId  Int?              @unique

  @@index([status])
  @@index([scenarioId])
  @@map("PlanningJob")
  @@schema("prisma")
}

enum PlanningRunStatus {
  PENDING
  COMPLETE
  EMPTY

  @@schema("prisma")
}

enum PlanningJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED

  @@schema("prisma")
}
