#!/usr/bin/env sh
set -e

. "$(dirname -- "$0")/ensure-nub.sh"

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/app"

# Topic-docs: regenerate JSON, then fail if committed output is stale (git diff vs HEAD)
nub run topic-docs-build || exit 1
git -C "$ROOT" diff --exit-code -- app/src/data/generated/topicDocs || exit 1

# Env contract docs: regenerate .github/README and fail if stale
nub "$ROOT/.github/scripts/generate-github-readme.ts" || exit 1
# Keep generated markdown aligned with repo formatting rules before checking diffs
nub run format:github || exit 1
git -C "$ROOT" diff --exit-code -- .github/README.md || exit 1

# Linting, formatting and type-checks for `App`
nub run check
nub run type-check-deploy

# Type checks (Lua + tsc), lint/format, and tests for `Processing`
cd "$ROOT/processing"
nub run check
nub run test
