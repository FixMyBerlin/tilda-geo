    "papaparse": "^5.5.3",
    "parse-gitignore": "2.0.0",
    "picomatch": "^4.0.4",
    "preview-email": "3.1.3",
    "prisma": "7.8.0",
    "react-email": "6.6.0",
    "sharp": "0.35.1",
