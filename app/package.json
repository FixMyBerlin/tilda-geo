    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "slugify": "1.6.9",
    "tailwind-merge": "3.6.0",
    "terra-draw": "1.31.1",
    "terra-draw-maplibre-gl-adapter": "1.4.1",
    "tiny-invariant": "1.3.3",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1069.0",
