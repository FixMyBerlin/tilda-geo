{
  "name": "tilda-geo",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "author": "FixMyCity <hello@fixmycity.de>",
  "type": "module",
  "scripts": {
    "start": "vite preview --host 127.0.0.1 --port 4000 --strictPort",
    "dev": "bun --env-file=../.env --env-file=../.env.local run --parallel dev:*",
    "dev:vite": "FORCE_COLOR=1 bun --bun vite dev --host 127.0.0.1 --strictPort",
    "dev:topic-docs-watch": "bun ./scripts/topic-docs-build/watch.ts",
    "predev": "bun scripts/predev/ensureEnv.ts && bun --env-file=../.env --env-file=../.env.local scripts/predev/ensureDevStack.ts && bun --env-file=../.env --env-file=../.env.local run --sequential predev:*",
    "predev:2dev-port": "bun scripts/predev/checkDevServer.ts",
    "predev:3docker": "bun scripts/predev/checkDocker.ts",
    "predev:4migration": "bun scripts/predev/checkMigration.ts --non-interactive",
    "predev:5geo-bootstrap": "bun --env-file=../.env --env-file=../.env.local scripts/predev/checkGeoBootstrap.ts",
    "predev:6topic-docs": "bun run topic-docs-build",
    "predev:7package-updates": "bun scripts/predev/checkPackageUpdates.ts",
    "setup-worktree": "bun scripts/setup-worktree.ts",
    "db-pull": "bun --env-file=../.env --env-file=../.env.local scripts/db-pull/run.ts",
    "db-pull:pull": "bun --env-file=../.env --env-file=../.env.local scripts/db-pull/pull.ts",
    "db-pull:restore": "bun --env-file=../.env --env-file=../.env.local scripts/db-pull/restore-local.ts",
    "data-schema-verify": "bun --env-file=../.env --env-file=../.env.local ./scripts/data-schema/verify/index.ts",
    "data-schema-pull": "bun --env-file=../.env --env-file=../.env.local ./scripts/data-schema/pull/index.ts",
    "data-schema-load": "bun --env-file=../.env --env-file=../.env.local ./scripts/data-schema/load/index.ts",
    "data-schema-publish": "bun --env-file=../.env --env-file=../.env.local ./scripts/data-schema/publish/index.ts",
    "audit-public-schema": "bun --env-file=../.env --env-file=../.env.local scripts/audit-public-schema/index.ts",
    "build": "vite build",
    "preview": "cd .output && NITRO_PORT=4000 NITRO_HOST=127.0.0.1 bun --env-file=../.env --env-file=../.env.local ./server/index.mjs",
    "bleach": "rm -rf node_modules/ && rm -rf .output/ && bun install",
    "bleach-full": "rm bun.lock && bun run bleach",
    "docker-cleanup": "bun scripts/docker-cleanup/index.ts",
    "knip": "KNIP_STRICT=1 knip --config knip.config.mjs",
    "knip-warn": "knip --config knip.config.mjs || true",
    "env-check:verify-manifest": "bun ../.github/scripts/verify-env-manifest.ts",
    "env-check:docs": "bun run --sequential env-check:docs:*",
    "env-check:docs:1sync": "bun ../.github/scripts/generate-github-readme.ts",
    "env-check:docs:2format": "bun run format",
    "env-check": "bun run --parallel env-check:*",
    "studio": "bun --env-file=../.env --env-file=../.env.local prisma studio",
    "migrate": "bun --env-file=../.env --env-file=../.env.local prisma migrate dev",
    "migrate-create": "bun run --sequential migrate-create:*",
    "migrate-create:1write": "bun --env-file=../.env --env-file=../.env.local prisma migrate dev --create-only",
    "migrate-create:2format": "oxfmt --write ./prisma/migrations",
    "migrate-create:3open": "code $(find ./prisma/migrations -type f -name 'migration.sql' -cmin -1 | head -n 1)",
    "migrate-check": "bun --env-file=../.env --env-file=../.env.local prisma migrate status",
    "migrate-compare": "git diff origin/main... -- prisma/migrations",
    "seed": "bun run --sequential seed:*",
    "seed:1ensure-env": "bun scripts/predev/ensureEnv.ts",
    "seed:2ensure-dev-stack": "bun --env-file=../.env --env-file=../.env.local scripts/predev/ensureDevStack.ts",
    "seed:3docker": "bun --env-file=../.env --env-file=../.env.local scripts/predev/checkDocker.ts",
    "seed:4migrate-reset": "bun --env-file=../.env --env-file=../.env.local prisma migrate reset --force",
    "seed:5db-seed": "bun --env-file=../.env --env-file=../.env.local prisma db seed",
    "seed:6data-schema": "bun --env-file=../.env --env-file=../.env.local ./scripts/data-schema/pullDataSpecsDuringSeed.ts",
    "check": "bun run --parallel type-check lint format test-run knip-warn",
    "check-ci": "bun run --parallel type-check lint-check format-check test-run",
    "check-pre-push": "bun run --parallel type-check-deploy lint format test-run knip build",
    "type-check": "tsc --noEmit",
    "type-check-deploy": "sh -c 'bun run static-datasets-unlink && bun run type-check; EXIT_CODE=$?; bun run static-datasets-link; exit $EXIT_CODE'",
    "lint": "bun run --parallel lint:*",
    "lint:main": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs .",
    "lint:static-datasets-code": "oxlint --fix --fix-dangerously --deny-warnings -c oxlint.config.mjs scripts/StaticDatasets scripts/StaticDatasets/geojson",
    "lint-check": "oxlint --deny-warnings -c oxlint.config.mjs .",
    "format": "bun run --parallel format:*",
    "format-check": "cd .. && oxfmt --check -c app/oxfmt.config.mjs .",
    "format:main": "cd .. && oxfmt --write -c app/oxfmt.config.mjs .",
    "format:static-datasets-code": "oxfmt --write -c oxfmt.static-datasets-code.config.mjs scripts/StaticDatasets scripts/StaticDatasets/geojson",
    "format-static-datasets-geojson": "oxfmt --write -c oxfmt.static-datasets-geojson.config.mjs",
    "test": "bun --env-file=../.env --env-file=../.env.local vitest watch",
    "test-run": "bun --env-file=../.env --env-file=../.env.local vitest run --passWithNoTests",
    "e2e": "playwright test --project=chromium",
    "mailpreview": "REACT_EMAIL_PREVIEW=1 VITE_APP_ORIGIN=http://127.0.0.1:5173 email dev --dir src/emails",
    "processing": "bun ./scripts/processing-generate-command/index.ts -- --skip-download 1 --skip-warm-cache 1 --skip-unchanged 0",
    "topic-docs-build": "bun run --sequential topic-docs-build:*",
    "topic-docs-build:1generate": "bun ./scripts/topic-docs-build/index.ts",
    "topic-docs-build:2format": "oxfmt --write -c oxfmt.config.mjs src/data/generated/topicDocs",
    "topic-docs-coverage-check": "bun --env-file=../.env --env-file=../.env.local ./scripts/topic-docs-coverage-check/index.ts",
    "mapbox-styles-update": "bun run --sequential mapbox-styles-update:*",
    "mapbox-styles-update:1process": "bun --env-file=../.env --env-file=../.env.local ./scripts/MapboxStyles/process.ts",
    "mapbox-styles-update:2lint": "bun run lint",
    "mapbox-styles-update:3format": "bun run format",
    "mapbox-styles-update:4github": "github",
    "static-datasets-update": "bun --env-file=../.env --env-file=../.env.local ./scripts/StaticDatasets/updateStaticDatasets.ts --folder-filter=",
    "static-datasets-download-sources": "bun --env-file=../.env --env-file=../.env.local ./scripts/StaticDatasets/updateDownloadSources.ts --folder-filter=",
    "static-datasets-link": "ln -sf ../../../../tilda-static-data/geojson scripts/StaticDatasets",
    "static-datasets-unlink": "rm -f scripts/StaticDatasets/geojson",
    "migration-data": "bun run --sequential migration-data:*",
    "migration-data:01-regions": "bun ./scripts/migration-data/01-regions-from-const.ts",
    "migration-data:02-config-templates": "bun ./scripts/migration-data/02-backfill-config-templates.ts",
    "migration-data:03-contracts": "bun ./scripts/migration-data/03-contracts-from-const.ts",
    "migration-data:04-verify-contracts": "bun ./scripts/migration-data/04-verify-contracts.ts",
    "migration-data-masks": "bun ./scripts/migration-data/05-generate-region-masks.ts",
    "mapbox-tilesets-update": "bun ./scripts/MapboxTilesets/process.ts",
    "translation-analysis-update": "bun ./scripts/TranslationAnalysis/analyze.ts",
    "maproulette-create": "bun run scripts/MaprouletteCreate/process.ts",
    "maproulette-rebuild": "bun run scripts/MaprouletteRebuild/process.ts",
    "maproulette-help": "echo -e '\\033[0;32m Help: Use `bun run maproulette-create -- --filter FOOBAR` \\033[0m' && echo -e '\\033[0;32m Rebuild: Use `bun run maproulette-rebuild -- --filter FOOBAR` \\033[0m'",
    "update": "bun scripts/updatePackages/index.ts",
    "release": "gh pr create --base main --head develop --title \"Release $(date '+%Y-%m-%d')\" --body \"\"",
    "postinstall": "bun scripts/prisma-generate-placeholder/index.ts",
    "prepare": "cd .. && husky app/.husky"
  },
