  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.1-rc",
    "@typescript/typescript-linux-x64": "7.0.1-rc"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not op_mini all",
    "not kaios > 0"
  ],
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=24.0.0"
  },
  "prisma": {
